# Database
POSTGRES_USER=fibenchi
POSTGRES_PASSWORD=fibenchi
POSTGRES_DB=fibenchi
DATABASE_URL=postgresql+asyncpg://fibenchi:fibenchi@db:5432/fibenchi

# Scheduled refresh (cron expression, default: daily at 23:00)
REFRESH_CRON=0 23 * * *

# Shioaji sidecar (credentials are consumed only by the shioaji container)
SJ_API_KEY=
SJ_SEC_KEY=
SJ_PRODUCTION=false
SJ_HTTP_ADDR=0.0.0.0:8080
SHIOAJI_BASE_URL=http://shioaji:8080
SHIOAJI_TIMEOUT_SECONDS=5
SHIOAJI_MAX_SUBSCRIPTIONS=180
